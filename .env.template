# .env.template — Copie para .env.local e preencha os valores
# NUNCA commite o .env.local no Git

# ================================================
# SUPABASE
# Dashboard: https://supabase.com/dashboard/project/_/settings/api
# ================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ================================================
# THE ODDS API
# Cadastro: https://the-odds-api.com
# Plano gratuito: 500 req/mês
# Plano básico (~US$25/mês): 10.000 req/mês
# ================================================
THE_ODDS_API_KEY=

# ================================================
# API-FOOTBALL (via RapidAPI)
# Cadastro: https://rapidapi.com/api-sports/api/api-football
# Plano gratuito: 100 req/dia
# ================================================
API_FOOTBALL_KEY=

# ================================================
# GEMINI API (Google)
# Cadastro: https://aistudio.google.com/app/apikey
# Plano gratuito: 1.500 req/dia
# ================================================
GEMINI_API_KEY=

# ================================================
# TELEGRAM BOT
# Criar bot: falar com @BotFather no Telegram
# Comando: /newbot → salve o token
# Username do bot (ex: OddsBRBot) → TELEGRAM_BOT_USERNAME
# Webhook secret: gere uma string aleatória segura (ex: openssl rand -hex 32)
# Registrar webhook: POST /api/admin/setup-webhook com Authorization: Bearer {INTERNAL_API_TOKEN}
# Cron jobs no VPS (crontab -e):
#   */10 * * * *  cd /srv/oddsbr/scripts && python alertas_odds.py >> logs/alertas.log 2>&1
#   0 0  * * *    cd /srv/oddsbr/scripts && python alertas_odds.py --reset >> logs/alertas.log 2>&1
#   0 8  * * *    cd /srv/oddsbr/scripts && python canal_telegram.py >> logs/canal.log 2>&1
# ================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=OddsBRBot
TELEGRAM_WEBHOOK_SECRET=
# ID do canal público (ex: @oddsbr ou -100xxxxxxxxxx)
TELEGRAM_CHANNEL_ID=

# ================================================
# SITE
# ================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ================================================
# AFILIADOS — tokens/parâmetros de rastreamento
# (preencher após aprovação em cada programa)
# ================================================
AFFILIATE_BETANO_ID=
AFFILIATE_SUPERBET_ID=
AFFILIATE_KTO_ID=
AFFILIATE_BET365_ID=
AFFILIATE_ESTRELABET_ID=

# ================================================
# STRIPE (fase 5 — premium)
# Deixar em branco por enquanto
# ================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ================================================
# INTERNO — token para scripts Python chamarem a API
# Gere qualquer string aleatória segura
# ================================================
INTERNAL_API_TOKEN=
